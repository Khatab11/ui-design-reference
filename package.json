{
  "name": "ui-design-reference",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:agent",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate-content.mjs",
    "generate:agent": "node scripts/generate-agent-files.mjs",
