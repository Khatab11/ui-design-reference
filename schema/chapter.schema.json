{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chapter",
  "type": "object",
  "required": ["id", "order", "title", "intro", "sections"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "order": { "type": "number" },
    "title": { "$ref": "#/definitions/localized" },
    "intro": { "$ref": "#/definitions/localized" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "body"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "$ref": "#/definitions/localized" },
          "body": { "$ref": "#/definitions/localized" },
          "asset": {
            "type": "object",
            "required": ["file", "alt", "ratio", "brief"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "alt": { "$ref": "#/definitions/localized" },
              "ratio": { "type": "string", "pattern": "^\\d+:\\d+$" },
              "brief": { "type": "string" }
            }
          },
          "callout": {
            "type": "object",
            "required": ["type", "en", "ar"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["tip", "warning", "quote", "note"] },
              "en": { "type": "string" },
              "ar": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "localized": {
      "type": "object",
      "required": ["en", "ar"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string" },
        "ar": { "type": "string" }
      }
    }
  }
}
